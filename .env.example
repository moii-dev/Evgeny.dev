# All VITE_ values are public build-time configuration; never put secrets here.
# Public site URL including its deployment subfolder. Required for absolute OG/canonical URLs.
VITE_SITE_URL=""
# Optional override; otherwise inferred from VITE_SITE_URL, defaults to / for local development.
VITE_BASE_PATH=""
# Optional HTTP(S) endpoint. Empty uses the honest mailto workflow.
VITE_CONTACT_FORM_ENDPOINT=""
# Optional Telegram profile override; leave empty to keep the existing profile.
VITE_TELEGRAM_URL=""
